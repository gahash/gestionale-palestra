# =====================================================================
# Gym Studio - configurazione ambiente
# Copia questo file in ".env" (stesso livello) e compila i valori.
# Il progetto NON deve mai contenere un dominio fisso: tutto qui.
# =====================================================================

# --- Applicazione ---
APP_NAME="Gym Studio"
APP_ENV=production
# Lasciare vuoto per usare percorsi relativi (funziona su qualsiasi dominio/sottocartella).
# Valorizzare solo se serve generare link assoluti (es. in email, sitemap).
APP_URL=
APP_DEBUG=false
APP_TIMEZONE=Europe/Rome
# Cambiare con una stringa lunga e casuale prima di andare in produzione.
APP_SECRET=cambia-questa-chiave-segreta-lunga-e-casuale

# --- Tenant attivo (in installazione single-tenant, di solito 1) ---
TENANT_SLUG=gym-studio

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_studio
DB_USER=gymstudio
DB_PASS=cambia-password-db
DB_CHARSET=utf8mb4
# Solo per docker-compose: password root del container MariaDB.
# Con Docker impostare anche DB_HOST=db.
DB_ROOT_PASSWORD=cambia-password-root

# --- Email (per notifiche lead / staff) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=utente-smtp
MAIL_PASS=cambia-password-smtp
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Gym Studio"
MAIL_TO_STAFF=info@example.com

# --- WhatsApp Business API (opzionale, disattivo finché non configurato) ---
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
# meta: Meta Cloud API
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
# twilio: Twilio WhatsApp
WHATSAPP_TWILIO_SID=
WHATSAPP_TWILIO_TOKEN=
WHATSAPP_TWILIO_FROM=

# --- Sicurezza sessione admin ---
SESSION_LIFETIME_MIN=120

# --- Script di deploy opzionali (upload_ftp.ps1 / db_import.ps1) ---
# Letti come variabili d'ambiente della shell PowerShell, NON dall'applicazione.
# Le password non vanno mai scritte qui: gli script le chiedono in modo mascherato.
FTP_HOST=ftp.example.com
FTP_USER=utente-ftp
FTP_PORT=21
FTP_REMOTE_ROOT=public_html
MYSQL_EXE=
